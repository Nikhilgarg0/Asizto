rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SEC-3: User-scoped rules — users can only access their own documents.

    match /medicines/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    match /appointments/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /emergencyContacts/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // OTP verification must only be readable/writable server-side (Cloud Function)
    match /otp_verifications/{email} {
      allow read, write: if false;
    }

  }
}
