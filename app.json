{
  "expo": {
    "name": "ASIZTO India",
    "slug": "asizto-india",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/cfae5437-9b6b-43f3-ab56-abff66ab70d4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.nikhilcodes.asizto",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ASIZTO India uses your location to find nearby pharmacies and emergency services.",
        "NSLocationAlwaysUsageDescription": "ASIZTO India uses your location to provide emergency assistance.",
        "NSCameraUsageDescription": "ASIZTO India needs camera access to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "ASIZTO India needs photo library access to set your profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "in.nikhilcodes.asizto",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "asizto.nikhilcodes.in",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "scheme": "asizto",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "cfae5437-9b6b-43f3-ab56-abff66ab70d4"
      }
    },
    "owner": "nikhilgarg8982",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#06B6D4",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ASIZTO India needs photo access to set your profile picture.",
          "cameraPermission": "ASIZTO India needs camera access to take a profile photo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ASIZTO India uses your location to find nearby pharmacies and emergency services."
        }
      ]
    ]
  }
}